#!/bin/sh
# Blocks direct pushes to main. GitHub's free plan can't protect main on a
# private repo, so this hook is what stops accidental pushes.
# Enable once per clone:  git config core.hooksPath .githooks

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push to main blocked. Push a branch and open a pull request instead:"
    echo "  git switch -c feat/<short-name>"
    echo "  git push -u origin feat/<short-name>"
    exit 1
  fi
done

exit 0
